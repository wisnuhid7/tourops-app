# Production example environment
PORT=5001
API_PORT=5001
API_TARGET=https://api.example.com
DATABASE_URL=postgresql://postgres:secure_password@postgres:5432/tourops
REDIS_URL=redis://redis:6379
SESSION_SECRET=REPLACE_WITH_STRONG_RANDOM
SEED_SECRET=REPLACE_WITH_STRONG_RANDOM
NODE_ENV=production

# ---- AI (optional) ----
# Needed for AI features (sight enrichment, tour generation, auto-translation).
# Provide a raw OpenAI key ...
OPENAI_API_KEY=
# ... or point at an OpenAI-compatible proxy instead (do not set both):
# AI_INTEGRATIONS_OPENAI_BASE_URL=
# AI_INTEGRATIONS_OPENAI_API_KEY=
# Optional model override. Defaults to gpt-5 for the proxy, gpt-4o-mini for a raw key.
# AI_MODEL=
